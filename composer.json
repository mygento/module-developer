{
  "name": "mygento/module-developer",
  "type": "magento2-module",
  "license": "OSL-3.0",
  "homepage": "https://github.com/mygento/module-developer",
  "description": "Mygento Developer Module",
  "authors": [
    {
      "name": "Nikita Tarasov",
      "email": "nikita@mygento.com",
      "homepage": "https://www.mygento.com/",
      "role": "Developer"
    },
    {
      "name": "Mygento",
      "email": "hello@mygento.com",
      "homepage": "https://www.mygento.com/"
    }
  ],
  "keywords": [
    "magento2",
    "mygento"
  ],
  "require": {
    "magento/module-deploy": "100.4.*"
  },
  "require-dev": {
    "mygento/coding-standard": "~2.14.0"
  },
  "prefer-stable": true,
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Mygento\\Developer\\": ""
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.magento.com"
    }
  ],
  "config": {
    "allow-plugins": {
      "phpro/grumphp": true,
      "symfony/flex": false,
      "magento/composer-dependency-version-audit-plugin": false
    }
  }
}
